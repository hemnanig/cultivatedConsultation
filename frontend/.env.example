# Copy this file to .env.local (gitignored) and fill in for local dev.
VITE_API_BASE_URL=http://localhost:8080

# Not currently used by any component — our login flow is a full-page redirect
# to the backend's /oauth2/authorization/google (server-side, via api.js
# googleLoginUrl()), so the frontend never talks to Google directly.
# Kept here in case we later switch to a client-side "Sign in with Google"
# button (Google Identity Services) instead of the redirect flow — that would
# need the backend to verify Google ID tokens directly, a different auth path
# than the current Spring Security oauth2Login setup.
VITE_GOOGLE_CLIENT_ID=
